<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.DoggySitter.ScreenTitle" parent="">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DoggySitter.SectionTitle" parent="">
        <item name="android:textColor">@color/ds_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DoggySitter.FieldLabel" parent="">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DoggySitter.Body" parent="">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.DoggySitter.BodySecondary" parent="">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.DoggySitter.CardTitle" parent="">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.DoggySitter.CardMeta" parent="">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.DoggySitter.EmptyState" parent="">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="Widget.DoggySitter.Button.Primary" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_button_primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DoggySitter.Button.Secondary" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_button_secondary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DoggySitter.Button.Danger" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_button_danger_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.DoggySitter.Button.Dashboard" parent="@android:style/Widget.Button">
        <item name="android:background">@drawable/bg_dashboard_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_button_dashboard_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <style name="Widget.DoggySitter.Button.DashboardPrimary" parent="Widget.DoggySitter.Button.Dashboard">
        <item name="android:background">@drawable/bg_dashboard_primary_action</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/ds_button_dashboard_primary_text</item>
    </style>

    <style name="Widget.DoggySitter.Input" parent="@android:style/Widget.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textColorHint">@color/ds_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.DoggySitter.Spinner" parent="@android:style/Widget.Spinner">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Widget.DoggySitter.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ds_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/ds_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.DoggySitter.Card.Compact" parent="Widget.DoggySitter.Card">
        <item name="cardCornerRadius">16dp</item>
        <item name="contentPadding">14dp</item>
    </style>

    <style name="Animation.DoggySitter.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_slide_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>
</resources>
