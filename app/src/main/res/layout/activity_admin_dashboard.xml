<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    tools:context=".activities.admin.AdminDashboardActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:textDirection="rtl">

        <TextView
            style="@style/TextAppearance.DoggySitter.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_admin_dashboard"
            android:textAlignment="viewStart" />

        <Button
            android:id="@+id/button_users"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/users" />

        <Button
            android:id="@+id/button_walk_requests"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/walk_requests" />

        <Button
            android:id="@+id/button_reviews"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reviews" />

        <Button
            android:id="@+id/button_statistics"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/statistics" />

        <Button
            android:id="@+id/button_logout"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/logout" />
    </LinearLayout>
</ScrollView>
