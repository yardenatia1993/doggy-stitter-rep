<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/ds_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="20dp"
    android:textDirection="rtl"
    tools:context=".activities.admin.AdminUsersActivity">

    <TextView
        style="@style/TextAppearance.DoggySitter.ScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/users" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_form_section"
        android:elevation="1dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_filter_role" />

        <Spinner
            android:id="@+id/spinner_role_filter"
            style="@style/Widget.DoggySitter.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_empty"
        style="@style/TextAppearance.DoggySitter.EmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_empty_state"
        android:padding="24dp"
        android:text="@string/no_admin_users"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_users"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_list_fade_in"
        android:paddingBottom="16dp" />
</LinearLayout>
