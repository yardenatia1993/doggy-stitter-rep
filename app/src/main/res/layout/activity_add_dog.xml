<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    tools:context=".activities.owner.AddDogActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_form_section"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:textDirection="rtl">

        <TextView
            android:id="@+id/text_title"
            style="@style/TextAppearance.DoggySitter.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_dog" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dog_name_required_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edit_dog_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autofillHints="name"
            android:hint="@string/dog_name_hint"
            android:inputType="textCapWords"
            android:textDirection="anyRtl" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/age_required_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinner_years"
                style="@style/Widget.DoggySitter.Spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/spinner_months"
                style="@style/Widget.DoggySitter.Spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/breed_required_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <AutoCompleteTextView
            android:id="@+id/edit_breed"
            style="@style/Widget.DoggySitter.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/breed"
            android:inputType="text"
            android:textDirection="rtl" />

        <TextView
            android:id="@+id/text_custom_breed_label"
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_breed_required_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl"
            android:visibility="gone" />

        <EditText
            android:id="@+id/edit_custom_breed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/custom_breed"
            android:inputType="textCapWords"
            android:textDirection="anyRtl"
            android:visibility="gone" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/notes_optional_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edit_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="top"
            android:hint="@string/notes"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textDirection="anyRtl" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_save_dog"
            style="@style/Widget.DoggySitter.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
