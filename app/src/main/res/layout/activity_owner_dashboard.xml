<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    tools:context=".activities.owner.OwnerDashboardActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:textDirection="rtl">

        <TextView
            style="@style/TextAppearance.DoggySitter.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_owner_dashboard"
            android:textAlignment="viewStart" />

        <Button
            android:id="@+id/button_create_walk_request"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/create_walk_request" />

        <Button
            android:id="@+id/button_add_dog"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/add_dog" />

        <Button
            android:id="@+id/button_my_dogs"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/my_dogs" />

        <Button
            android:id="@+id/button_my_requests"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/my_requests" />

        <Button
            android:id="@+id/button_logout"
            style="@style/Widget.DoggySitter.Button.Dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/logout" />
    </LinearLayout>
</ScrollView>
