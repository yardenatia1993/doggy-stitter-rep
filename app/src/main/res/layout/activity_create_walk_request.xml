<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    tools:context=".activities.owner.CreateWalkRequestActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_form_section"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:textDirection="rtl">

        <TextView
            style="@style/TextAppearance.DoggySitter.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_create_walk_request" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/select_dog_required_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <Spinner
            android:id="@+id/spinner_dogs"
            style="@style/Widget.DoggySitter.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/date_required_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edit_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="false"
            android:hint="@string/choose_date"
            android:inputType="none"
            android:textDirection="rtl" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/time_required_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edit_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="false"
            android:hint="@string/choose_time"
            android:inputType="none"
            android:textDirection="rtl" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/duration_required_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <Spinner
            android:id="@+id/spinner_duration"
            style="@style/Widget.DoggySitter.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/max_price_required_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edit_max_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/max_price"
            android:inputType="numberDecimal" />

        <TextView
            style="@style/TextAppearance.DoggySitter.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pickup_location_section"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <Button
            android:id="@+id/button_current_pickup_location"
            style="@style/Widget.DoggySitter.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/use_current_location" />

        <Button
            android:id="@+id/button_manual_pickup_location"
            style="@style/Widget.DoggySitter.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/choose_manual_location" />

        <TextView
            android:id="@+id/text_pickup_location_status"
            style="@style/TextAppearance.DoggySitter.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/location_not_selected"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/pickup_location_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edit_pickup_location_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/pickup_location_hint"
            android:inputType="text"
            android:textDirection="anyRtl" />

        <TextView
            style="@style/TextAppearance.DoggySitter.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/notes_optional_label"
            android:textAlignment="viewStart"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edit_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="top"
            android:hint="@string/notes"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textDirection="anyRtl" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_create_request"
            style="@style/Widget.DoggySitter.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/create_request" />
    </LinearLayout>
</ScrollView>
